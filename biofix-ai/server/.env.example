# Copy to .env (or export) before `npm start`.
# Lines starting with # are off. Values marked [SECRET] must never be committed or shared.

# --- Mode -----------------------------------------------------------------
# Set to "production" on the real server: it closes the API to other websites (CORS)
# and makes sure e-mail codes can never be printed in the log.
# NODE_ENV=production

# --- AI -------------------------------------------------------------------
# [SECRET] Claude API key.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# BIOFIX_MODEL=claude-opus-5-5
# How hard the model thinks about a fault: low | medium | high (default high).
# Lower is quicker and cheaper, higher is more careful.
# BIOFIX_EFFORT=high
# Faster answers at a higher price per token, on models that offer it.
# BIOFIX_SPEED=fast
# Largest PDF a technician may attach to a fault report, in pages (default 30).
# Every page the AI reads costs tokens.
# MAX_ATTACH_PAGES=30

# --- Server ---------------------------------------------------------------
PORT=8787
# DATA_FILE=./data/db.json
# [SECRET] Encrypts the data file on disk (AES-256-GCM). Generate once with: openssl rand -base64 32
# Keep a copy somewhere safe: without it the data file cannot be read.
# DATA_ENCRYPTION_KEY=
# Set to 1 when the server runs behind a reverse proxy (nginx, Render, Fly, Railway…),
# so rate limits and HTTPS detection see the real client.
# TRUST_PROXY=1
# Refuse plain-http requests (needs TRUST_PROXY behind a proxy).
# REQUIRE_HTTPS=1
# Websites allowed to call the API from a browser, comma separated. The phone app does not need this.
# CORS_ORIGIN=https://app.yourdomain.com
# [SECRET] Unlocks the developer panel (manual upload, revenue). At least 24 characters:
#   openssl rand -base64 32
ADMIN_TOKEN=

# --- E-mail (address verification and password reset codes) --------------
# [SECRET] Required. A new account must type the 6-digit code sent to its address before it
# can use the app, so without this nobody can register or reset a password.
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# MAIL_FROM=BioFix AI <no-reply@yourdomain.com>
# LOCAL TESTING ONLY: print the codes in the server log instead of e-mailing them.
# Ignored when NODE_ENV=production. Never enable on a server real people use.
# PRINT_EMAIL_CODES=true

# --- Google Play Billing --------------------------------------------------
# Package name of the app in Play Console (must match app/app.json → android.package).
# GOOGLE_PLAY_PACKAGE=com.biofix.ai
# [SECRET] Service account key with access to the Play Developer API (file path, or the JSON itself).
# GOOGLE_SERVICE_ACCOUNT_FILE=./play-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# [SECRET] At least 16 characters. Real-time notification URL:
#   https://YOUR-SERVER/api/billing/rtdn?token=<this value>
# PLAY_RTDN_SECRET=

# --- Payments and points --------------------------------------------------
# LOCAL TESTING ONLY: "card" buttons succeed without charging, "Demo:" buttons are shown and
# new accounts get 500 free points. Off unless this line is present. Never enable for real users.
# DEMO_PAYMENTS=true
# Points given to a new account. Default: 0 (500 with demo payments). Points are worth money.
# WELCOME_POINTS=0

# --- Logging --------------------------------------------------------------
# Security events (sign-ins, password changes, purchases, developer actions) are logged as JSON lines.
# AUDIT_LOG=off
