# Copy to .env (or export) before `npm start`.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# BIOFIX_MODEL=claude-opus-5-5
# Token that unlocks the developer panel (manual upload, revenue). Choose a long random string.
ADMIN_TOKEN=
PORT=8787
# Set to false in production to disable demo card payments and demo simulation buttons.
DEMO_PAYMENTS=true
# DATA_FILE=./data/db.json
