{
  "expo": {
    "name": "BioFix AI",
    "slug": "biofix-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biofix.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2F4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.biofix.ai",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "BioFix AI arıza ve onarım fotoğraflarını eklemek için fotoğraflarına erişir.",
          "cameraPermission": "BioFix AI arızalı cihazın fotoğrafını çekmek için kameranı kullanır.",
          "microphonePermission": false
        }
      ],
      "expo-iap",
      "expo-secure-store"
    ],
    "scheme": "biofix",
    "experiments": {
      "typedRoutes": false
    }
  }
}
